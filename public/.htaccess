# América — URL limpa do catálogo: /catalogo-2026 abre catalogo-2026.html
<IfModule mod_rewrite.c>
RewriteEngine On

# www → sem www (endereço oficial: https://americaindustria.com.br)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Arquivos/pastas ocultos (.DS_Store, .git, .env...) nunca são servidos — exceto .well-known (SSL)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F,L]

RewriteRule ^catalogo-2026/?$ /catalogo-2026.html [L]

# PDF antigo (48 MB, nome com acento/espaço) → versão leve nova
RewriteRule ^Cat[^/]*COMPLETO\.pdf$ /catalogo-america-2026.pdf [R=301,L]
</IfModule>

# Cabeçalhos de segurança
<IfModule mod_headers.c>
# HSTS conservador: 1 semana, sem subdomínios, sem preload (aumentar depois de validar)
Header always set Strict-Transport-Security "max-age=604800"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'self'"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>
